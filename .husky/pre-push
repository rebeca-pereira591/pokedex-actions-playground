# Antes de subir: type check y lint del front, sólo si lo que se sube toca web/.
# Git pasa por stdin una línea por rama: <ref local> <sha local> <ref remoto> <sha remoto>.

zero=0000000000000000000000000000000000000000
touches_web=false

while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue          # se está borrando una rama: nada que revisar
  if [ "$remote_sha" = "$zero" ]; then
    base=$(git merge-base origin/main "$local_sha") # rama nueva: comparar contra main
  else
    base=$remote_sha                                # rama existente: sólo los commits nuevos
  fi
  if git diff --name-only "$base" "$local_sha" | grep -q '^web/'; then
    touches_web=true
  fi
done

if [ "$touches_web" = false ]; then
  echo "pre-push: no hay cambios en web/, se saltea el chequeo del front."
  exit 0
fi

echo "pre-push: type check del front..."
web/node_modules/.bin/tsc -b web || {
  echo "pre-push: hay errores de tipos. Push cancelado."
  exit 1
}

echo "pre-push: lint del front..."
(cd web && node_modules/.bin/biome check .) || {
  echo "pre-push: hay errores de lint. Push cancelado."
  exit 1
}
