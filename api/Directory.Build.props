<!-- Se aplica a todos los proyectos de api/. Hace que el build sea también el linter de C#. -->
<Project>

  <PropertyGroup>
    <!-- Un warning rompe el build: el código con problemas no compila. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Las reglas de estilo del IDE (IDExxxx) también corren en el build, no sólo en el editor. -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <!-- Las vulnerabilidades de paquetes (NU190x) quedan como aviso: las atrapa Dependabot en la fase 5. -->
    <WarningsNotAsErrors>NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- Bugs probables, código sospechoso y complejidad. -->
    <PackageReference Include="SonarAnalyzer.CSharp" Version="10.35.0.4138" PrivateAssets="all" />
    <!-- Estilo: orden, espacios, nombres, llaves. Su última versión publicada sigue siendo beta. -->
    <PackageReference Include="StyleCop.Analyzers" Version="1.2.0-beta.556" PrivateAssets="all" />
  </ItemGroup>

</Project>
